<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>org.sisterhl2030.printer</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/Printers/SisterHL2030/sister-printer-app</string>
		<string>server</string>
		<string>-o</string>
		<string>server-port=8631</string>
		<string>-o</string>
		<string>spool-directory=/Library/Printers/SisterHL2030/spool</string>
		<string>-o</string>
		<string>log-file=/Library/Logs/SisterHL2030.log</string>
		<string>-o</string>
		<string>log-level=info</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Library/Logs/SisterHL2030.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/SisterHL2030.log</string>
</dict>
</plist>
